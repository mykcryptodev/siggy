{
  "name": "safe-transparency-bot",
  "version": "1.0.0",
  "description": "Telegram bot (siggy) that monitors Gnosis Safe multisig wallets and posts human-readable transaction notifications",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.41.0",
    "grammy": "^1.31.0",
    "ioredis": "^5.3.2",
    "postgres": "^3.4.5",
    "thirdweb": "^5.120.0",
    "viem": "^2.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^5.8.2",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
